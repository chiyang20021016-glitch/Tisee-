.deer-run {
  position: relative;
  width: min(var(--deer-size, 420px), 100%);
  aspect-ratio: 699 / 502;
  display: inline-block;
  overflow: visible;
}

.deer-stage {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform-origin: 50% 60%;
  will-change: transform;
}

.deer-part {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  pointer-events: none;
  user-select: none;
}

.deer-leg {
  will-change: transform;
}


/* LEG PIVOTS */

.hind-back {
  transform-origin: 16.8% 56.3%;
}

.hind-front {
  transform-origin: 25% 56.8%;
}

.front-back {
  transform-origin: 56.5% 56.8%;
}

.front-front {
  transform-origin: 61.8% 57.3%;
}


/* BODY MOVEMENT */

.is-running .deer-stage {
  animation:
    deer-body-bounce
    calc(var(--run-speed) * 0.5)
    ease-in-out
    infinite;
}


/* DIAGONAL LEG PAIR A */

.is-running .hind-back,
.is-running .front-front {
  animation:
    deer-leg-a
    var(--run-speed)
    ease-in-out
    infinite;
}


/* DIAGONAL LEG PAIR B */

.is-running .hind-front,
.is-running .front-back {
  animation:
    deer-leg-b
    var(--run-speed)
    ease-in-out
    infinite;
}


/* LEG ANIMATION A */

@keyframes deer-leg-a {

  0% {
    transform:
      rotate(-5deg)
      translateY(0);
  }

  20% {
    transform:
      rotate(16deg)
      translateY(2%);
  }

  40% {
    transform:
      rotate(5deg)
      translateY(-1%);
  }

  60% {
    transform:
      rotate(-16deg)
      translateY(-2%);
  }

  80% {
    transform:
      rotate(-8deg)
      translateY(1%);
  }

  100% {
    transform:
      rotate(-5deg)
      translateY(0);
  }
}


/* LEG ANIMATION B */

@keyframes deer-leg-b {

  0% {
    transform:
      rotate(10deg)
      translateY(-1%);
  }

  20% {
    transform:
      rotate(-12deg)
      translateY(-2%);
  }

  40% {
    transform:
      rotate(-5deg)
      translateY(1%);
  }

  60% {
    transform:
      rotate(16deg)
      translateY(2%);
  }

  80% {
    transform:
      rotate(8deg)
      translateY(0);
  }

  100% {
    transform:
      rotate(10deg)
      translateY(-1%);
  }
}


/* BODY BOUNCE */

@keyframes deer-body-bounce {

  0% {
    transform:
      translateY(0)
      rotate(0deg);
  }

  25% {
    transform:
      translateY(-1.2%)
      rotate(-0.3deg);
  }

  50% {
    transform:
      translateY(0.4%)
      rotate(0deg);
  }

  75% {
    transform:
      translateY(-0.9%)
      rotate(0.25deg);
  }

  100% {
    transform:
      translateY(0)
      rotate(0deg);
  }

}


/* ACCESSIBILITY */

@media (prefers-reduced-motion: reduce) {

  .is-running .deer-stage,
  .is-running .deer-leg {
    animation: none !important;
  }

}

